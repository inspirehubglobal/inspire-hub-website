---
import Base from "../layouts/Base.astro";
import { getEntry, getCollection } from "astro:content";

const entry = await getEntry("pages", "home");
if (!entry) throw new Error("home.md not found in src/content/pages/");
const p = entry.data as any;

// Featured blog posts (latest 4, not drafts)
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const featured = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const SITE = "https://inspirehubglobal.com";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${SITE}/#mabel`,
      name: "Mabel De Peña",
      alternateName: "María Isabel De Peña Meyreles",
      jobTitle: "Coach ICF certificada",
      description: "Coach ICF certificada con 20 años en banca corporativa. Acompaña turning points de vida y carrera con método ECO y BMAP.",
      url: SITE,
      image: `${SITE}/assets/photos/mabel-v2.png`,
      sameAs: [
        "https://instagram.com/inspirehubglobal",
        "https://www.linkedin.com/company/inspire-hub-global"
      ],
      worksFor: { "@id": `${SITE}/#org` }
    },
    {
      "@type": "ProfessionalService",
      "@id": `${SITE}/#org`,
      name: "Inspire Hub Global",
      founder: { "@id": `${SITE}/#mabel` },
      url: SITE,
      logo: `${SITE}/assets/logos/logo-verde.png`,
      email: "hola@inspirehubglobal.com",
      address: { "@type": "PostalAddress", addressLocality: "Santo Domingo", addressCountry: "DO" },
      priceRange: "$$$",
      sameAs: [
        "https://instagram.com/inspirehubglobal",
        "https://www.linkedin.com/company/inspire-hub-global"
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      url: SITE,
      name: "Inspire Hub Global",
      inLanguage: "es-DO",
      publisher: { "@id": `${SITE}/#org` }
    }
  ]
};
---

<Base
  title={p.title}
  description={p.description}
  ogImage="/assets/photos/cemento-y-flores.png"
  schema={schema}
  navTheme="dark"
>

  <header class="hero">
    <div class="wrap">
      <div class="hero-top">
        <span class="eyebrow">{p.heroEyebrow}</span>
      </div>

      <h1 class="display">
        {p.heroTitleStart} <span class="script">{p.heroTitleScript}</span> {p.heroTitleEnd}
      </h1>

      <div class="hero-bottom">
        <p class="lead">{p.heroLead}</p>
        <div>
          <div class="hero-actions">
            <a href={p.heroCtaPrimaryLink} class="btn">{p.heroCtaPrimaryText}</a>
            <a href={p.heroCtaSecondaryLink} class="btn ghost">{p.heroCtaSecondaryText}</a>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-photo">
      <img src={p.heroImage} alt="Mabel De Peña Meyreles" onerror="this.style.display='none';" />
    </div>
    <div class="hero-signature">{p.heroSignature}</div>
  </header>

  <div class="marquee">
    <div class="marquee-track">
      {p.marquee1Items.map((item: string) => <span class="marquee-item">{item}</span>)}
      {p.marquee1Items.map((item: string) => <span class="marquee-item">{item}</span>)}
    </div>
  </div>

  <section class="manifesto">
    <div class="wrap">
      <div class="manifesto-grid">
        <div class="photo-col">
          <img src={p.manifestoImage} alt="Mabel · coach Inspire Hub Global" />
        </div>
        <div class="body-col">
          <span class="eyebrow lima">{p.manifestoEyebrow}</span>
          <h2 class="pullquote">{p.manifestoTitleStart} <span class="script">{p.manifestoTitleScript}</span>{p.manifestoTitleEnd}</h2>
          <p class="lead">{p.manifestoLead}</p>
          <p>{p.manifestoP2}</p>
          <p>{p.manifestoP3Start}<strong>{p.manifestoP3Bold}</strong></p>
          <span class="signature">{p.manifestoSignature}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="eco">
    <div class="eco-watermark">ECO</div>
    <div class="wrap">
      <header class="eco-head">
        <span class="eyebrow lima">{p.ecoEyebrow}</span>
        <h2>{p.ecoTitleStart} <span class="script block">{p.ecoTitleScript}</span></h2>
        <p>{p.ecoIntro}</p>
      </header>

      <ol class="eco-stack">
        {p.ecoMovements.map((m: any) => (
          <li class="eco-row">
            <span class="num">{m.letter}<small>{m.num}</small></span>
            <div class="content">
              <h3>{m.title}</h3>
              <p class="tag">{m.tag}</p>
              <p>{m.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="servicios">
    <div class="wrap">
      <div class="head">
        <h2 class="display">{p.serviciosTitleStart} <br /><span class="script">{p.serviciosTitleScript}</span> {p.serviciosTitleEnd}</h2>
        <p class="lead">{p.serviciosLead}</p>
      </div>

      {p.services.map((s: any) => (
        <a href={s.link} class="service">
          <div class="num">{s.num}</div>
          <div>
            <h3>{s.title}</h3>
            <div class="for">{s.for}</div>
            <p class="meta">{s.meta}</p>
          </div>
          <div>
            <p>{s.bodyStart}<strong>{s.bodyBold}</strong>{s.bodyEnd}</p>
            <p class="meta">{s.price}</p>
          </div>
          <div class="arrow">→</div>
        </a>
      ))}
    </div>
  </section>

  <section class="big-quote">
    <div class="wrap-tight">
      <span class="eyebrow lima">{p.bigQuoteEyebrow}</span>
      <q>{p.bigQuoteStart} <span class="script">{p.bigQuoteScript}</span> {p.bigQuoteEnd}</q>
      <div class="attribution">{p.bigQuoteAttribution}</div>
    </div>
  </section>

  <div class="marquee inverse">
    <div class="marquee-track">
      {p.marquee2Items.map((item: any) => (
        <span class={item.isScript ? "marquee-item script" : "marquee-item"}>{item.text}</span>
      ))}
      {p.marquee2Items.map((item: any) => (
        <span class={item.isScript ? "marquee-item script" : "marquee-item"}>{item.text}</span>
      ))}
    </div>
  </div>

  <section class="testimonios">
    <div class="wrap-tight">
      <div class="head">
        <span class="eyebrow">{p.testimoniosEyebrow}</span>
        <h2 class="display">{p.testimoniosTitleStart} <span class="script">{p.testimoniosTitleScript}</span> {p.testimoniosTitleEnd}</h2>
      </div>

      <div class="stack">
        {p.testimonios.map((t: any) => (
          <div class="testimonio">
            <div class="who-col">
              <img src={t.photo} alt={t.name} />
              <span class="who" set:html={`${t.name}<br>${t.role}`} />
            </div>
            <p class="quote">{t.quoteStart}<strong>{t.quoteBold}</strong>{t.quoteEnd}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="vitamina">
    <div class="wrap">
      <div class="vitamina-grid">
        <div class="cover">
          <div class="cover-art">
            <img src="/assets/podcast/vitamina-i-cover.png" alt="Vitamina I · podcast por Mabel" />
          </div>
        </div>
        <div class="content">
          <span class="eyebrow light">{p.vitaminaEyebrow}</span>
          <h2>{p.vitaminaTitleStart} <span class="script">{p.vitaminaTitleScript}</span> {p.vitaminaTitleEnd}</h2>
          <p>{p.vitaminaTextStart}<strong>{p.vitaminaTextBold}</strong></p>
          <a href="/vitamina-i" class="btn">{p.vitaminaCtaText}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="blog">
    <div class="head">
      <span class="eyebrow">{p.blogEyebrow}</span>
      <h2>{p.blogTitleStart} <span class="script">{p.blogTitleScript}</span>{p.blogTitleEnd}</h2>
    </div>
    <div class="blog-grid">
      {featured.map(post => (
        <a href={`/blog-${post.id}`} class="blog-card">
          {post.data.heroImage && (
            <div class="thumb thumb-photo">
              <img src={post.data.heroImage} alt={post.data.heroAlt || ""} />
            </div>
          )}
          <span class="category">{post.data.category}</span>
          <h3>{post.data.title} {post.data.titleScript}</h3>
          <span class="read">Leer →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="closing">
    <div class="wrap">
      <h2>{p.closingTitleStart}<span class="script">{p.closingTitleScript}</span> {p.closingTitleEnd}</h2>
      <p class="sub">{p.closingSubStart}<strong>{p.closingSubBold}</strong>{p.closingSubEnd}</p>
      <div class="actions">
        <a href={p.closingCtaPrimaryLink} class="btn">{p.closingCtaPrimaryText}</a>
        <a href={p.closingCtaSecondaryLink} class="btn ghost">{p.closingCtaSecondaryText}</a>
      </div>
    </div>
  </section>

</Base>
