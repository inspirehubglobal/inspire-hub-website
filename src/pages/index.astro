---
import Base from "../layouts/Base.astro";
import { getEntry, getCollection } from "astro:content";

const entry = await getEntry("pages", "home");
if (!entry) throw new Error("home.md not found");
const p = entry.data as any;

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const featured = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const SITE = "https://inspirehubglobal.com";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${SITE}/#mabel`,
      name: "Mabel De Peña",
      alternateName: "María Isabel De Peña Meyreles",
      jobTitle: "Coach ICF certificada",
      url: SITE,
      image: `${SITE}/assets/photos/mabel-v2.png`,
      sameAs: ["https://instagram.com/inspirehubglobal", "https://www.linkedin.com/company/inspire-hub-global"],
      worksFor: { "@id": `${SITE}/#org` }
    },
    {
      "@type": "ProfessionalService",
      "@id": `${SITE}/#org`,
      name: "Inspire Hub Global",
      founder: { "@id": `${SITE}/#mabel` },
      url: SITE,
      logo: `${SITE}/assets/logos/logo-verde.png`,
      email: "hola@inspirehubglobal.com",
      address: { "@type": "PostalAddress", addressLocality: "Santo Domingo", addressCountry: "DO" }
    },
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      url: SITE,
      name: "Inspire Hub Global",
      inLanguage: "es-DO"
    }
  ]
};
---

<Base
  title={p.title}
  description={p.description}
  ogImage="/assets/photos/cemento-y-flores.png"
  schema={schema}
  navTheme="dark"
>

  <header class="hero">
    <div class="wrap">
      <div class="hero-top">
        <span class="eyebrow">{p.hero.eyebrow}</span>
      </div>

      <h1 class="display">
        {p.hero.titleStart} <span class="script">{p.hero.titleScript}</span> {p.hero.titleEnd}
      </h1>

      <div class="hero-bottom">
        <p class="lead">{p.hero.lead}</p>
        <div>
          <div class="hero-actions">
            <a href={p.hero.ctaPrimaryLink} class="btn">{p.hero.ctaPrimaryText}</a>
            <a href={p.hero.ctaSecondaryLink} class="btn ghost">{p.hero.ctaSecondaryText}</a>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-photo">
      <img src={p.hero.image} alt="Mabel De Peña Meyreles" onerror="this.style.display='none';" />
    </div>
    <div class="hero-signature">{p.hero.signature}</div>
  </header>

  <div class="marquee">
    <div class="marquee-track">
      {p.marquee1Items.map((item: string) => <span class="marquee-item">{item}</span>)}
      {p.marquee1Items.map((item: string) => <span class="marquee-item">{item}</span>)}
    </div>
  </div>

  <section class="manifesto">
    <div class="wrap">
      <div class="manifesto-grid">
        <div class="photo-col">
          <img src={p.manifesto.image} alt="Mabel · coach Inspire Hub Global" />
        </div>
        <div class="body-col">
          <span class="eyebrow lima">{p.manifesto.eyebrow}</span>
          <h2 class="pullquote">{p.manifesto.titleStart} <span class="script">{p.manifesto.titleScript}</span>{p.manifesto.titleEnd}</h2>
          <p class="lead">{p.manifesto.lead}</p>
          <p>{p.manifesto.p2}</p>
          <p>{p.manifesto.p3Start}<strong>{p.manifesto.p3Bold}</strong></p>
          <span class="signature">{p.manifesto.signature}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="eco">
    <div class="eco-watermark">ECO</div>
    <div class="wrap">
      <header class="eco-head">
        <span class="eyebrow lima">{p.eco.eyebrow}</span>
        <h2>{p.eco.titleStart} <span class="script block">{p.eco.titleScript}</span></h2>
        <p>{p.eco.intro}</p>
      </header>

      <ol class="eco-stack">
        {p.eco.movements.map((m: any) => (
          <li class="eco-row">
            <span class="num">{m.letter}<small>{m.num}</small></span>
            <div class="content">
              <h3>{m.title}</h3>
              <p class="tag">{m.tag}</p>
              <p>{m.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="servicios">
    <div class="wrap">
      <div class="head">
        <h2 class="display">{p.servicios.titleStart} <br /><span class="script">{p.servicios.titleScript}</span> {p.servicios.titleEnd}</h2>
        <p class="lead">{p.servicios.lead}</p>
      </div>

      {p.servicios.items.map((s: any) => (
        <a href={s.link} class="service">
          <div class="num">{s.num}</div>
          <div>
            <h3>{s.title}</h3>
            <div class="for">{s.for}</div>
            <p class="meta">{s.meta}</p>
          </div>
          <div>
            <p>{s.bodyStart}<strong>{s.bodyBold}</strong>{s.bodyEnd}</p>
            <p class="meta">{s.price}</p>
          </div>
          <div class="arrow">→</div>
        </a>
      ))}
    </div>
  </section>

  <section class="big-quote">
    <div class="wrap-tight">
      <span class="eyebrow lima">{p.bigQuote.eyebrow}</span>
      <q>{p.bigQuote.start} <span class="script">{p.bigQuote.script}</span> {p.bigQuote.end}</q>
      <div class="attribution">{p.bigQuote.attribution}</div>
    </div>
  </section>

  <div class="marquee inverse">
    <div class="marquee-track">
      {p.marquee2Items.map((item: any) => (
        <span class={item.isScript ? "marquee-item script" : "marquee-item"}>{item.text}</span>
      ))}
      {p.marquee2Items.map((item: any) => (
        <span class={item.isScript ? "marquee-item script" : "marquee-item"}>{item.text}</span>
      ))}
    </div>
  </div>

  <section class="testimonios">
    <div class="wrap-tight">
      <div class="head">
        <span class="eyebrow">{p.testimonios.eyebrow}</span>
        <h2 class="display">{p.testimonios.titleStart} <span class="script">{p.testimonios.titleScript}</span> {p.testimonios.titleEnd}</h2>
      </div>

      <div class="stack">
        {p.testimonios.items.map((t: any) => (
          <div class="testimonio">
            <div class="who-col">
              <img src={t.photo} alt={t.name} />
              <span class="who" set:html={`${t.name}<br>${t.role}`} />
            </div>
            <p class="quote">{t.quoteStart}<strong>{t.quoteBold}</strong>{t.quoteEnd}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="vitamina">
    <div class="wrap">
      <div class="vitamina-grid">
        <div class="cover">
          <div class="cover-art">
            <img src="/assets/podcast/vitamina-i-cover.png" alt="Vitamina I · podcast por Mabel" />
          </div>
        </div>
        <div class="content">
          <span class="eyebrow light">{p.vitamina.eyebrow}</span>
          <h2>{p.vitamina.titleStart} <span class="script">{p.vitamina.titleScript}</span> {p.vitamina.titleEnd}</h2>
          <p>{p.vitamina.textStart}<strong>{p.vitamina.textBold}</strong></p>
          <a href="/vitamina-i" class="btn">{p.vitamina.ctaText}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="blog">
    <div class="head">
      <span class="eyebrow">{p.blogSection.eyebrow}</span>
      <h2>{p.blogSection.titleStart} <span class="script">{p.blogSection.titleScript}</span>{p.blogSection.titleEnd}</h2>
    </div>
    <div class="blog-grid">
      {featured.map(post => (
        <a href={`/blog-${post.id}`} class="blog-card">
          {post.data.heroImage && (
            <div class="thumb thumb-photo">
              <img src={post.data.heroImage} alt={post.data.heroAlt || ""} />
            </div>
          )}
          <span class="category">{post.data.category}</span>
          <h3>{post.data.title} {post.data.titleScript}</h3>
          <span class="read">Leer →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="closing">
    <div class="wrap">
      <h2>{p.closing.titleStart}<span class="script">{p.closing.titleScript}</span> {p.closing.titleEnd}</h2>
      <p class="sub">{p.closing.subStart}<strong>{p.closing.subBold}</strong>{p.closing.subEnd}</p>
      <div class="actions">
        <a href={p.closing.ctaPrimaryLink} class="btn">{p.closing.ctaPrimaryText}</a>
        <a href={p.closing.ctaSecondaryLink} class="btn ghost">{p.closing.ctaSecondaryText}</a>
      </div>
    </div>
  </section>

</Base>
