---
import Base from "../layouts/Base.astro";
import { getEntry } from "astro:content";

const entry = await getEntry("pages", "servicios-bmap");
if (!entry) throw new Error("servicios-bmap.md not found");
const p = entry.data as any;

const SITE = "https://inspirehubglobal.com";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${SITE}/#org`,
      name: "Inspire Hub Global",
      url: SITE
    },
    {
      "@type": "Service",
      name: "Evaluación BMAP",
      description: p.description,
      provider: { "@id": `${SITE}/#org` },
      url: `${SITE}/servicios-bmap`,
      serviceType: "Coaching"
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Servicios", item: `${SITE}/servicios` },
        { "@type": "ListItem", position: 3, name: "La foto · BMAP", item: `${SITE}/servicios-bmap` }
      ]
    }
  ]
};
---

<Base
  title={p.title}
  description={p.description}
  ogImage="/assets/photos/cemento-y-flores.png"
  schema={schema}
  navTheme="light"
>

  <header class="page-hero">
    <div class="page-hero-inner">
      <span class="eyebrow">{p.hero.eyebrow}</span>
      <h1>{p.hero.titleStart} <span class="script block">{p.hero.titleScript}</span></h1>
      <p class="lead">{p.hero.leadStart}<strong>{p.hero.leadBold}</strong></p>
      <div class="page-hero-actions">
        <a href={p.hero.ctaPrimaryLink} class="btn">{p.hero.ctaPrimaryText}</a>
        <a href={p.hero.ctaSecondaryLink} class="btn ghost">{p.hero.ctaSecondaryText}</a>
      </div>
    </div>
  </header>

  <section class="stats-bar">
    <div class="stats-grid">
      {p.stats.map((s: any) => (
        <div class="stat">
          <div class="stat-num">{s.num}<small>{s.suffix}</small></div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="manifesto">
    <div class="wrap">
      <div class="manifesto-grid">
        <div class="body-col">
          <span class="eyebrow lima">{p.manifesto.eyebrow}</span>
          <h2 class="pullquote">{p.manifesto.titleStart} <span class="script block">{p.manifesto.titleScript}</span></h2>
          <p class="lead">{p.manifesto.lead}</p>
          <p>{p.manifesto.p2Start}<strong>{p.manifesto.p2Bold}</strong>{p.manifesto.p2End}</p>
          <span class="signature">{p.manifesto.signature}</span>
        </div>
        <div class="photo-col">
          <div class="bmap-visual">
            <div class="bmap-graph" aria-hidden="true">
              <svg viewBox="0 0 200 200" width="100%" height="100%">
                <circle cx="100" cy="100" r="90" fill="none" stroke="rgba(31,61,59,.15)" stroke-width="1"/>
                <circle cx="100" cy="100" r="60" fill="none" stroke="rgba(31,61,59,.15)" stroke-width="1"/>
                <circle cx="100" cy="100" r="30" fill="none" stroke="rgba(31,61,59,.15)" stroke-width="1"/>
                <line x1="100" y1="10" x2="100" y2="190" stroke="rgba(31,61,59,.15)" stroke-width="1"/>
                <line x1="10" y1="100" x2="190" y2="100" stroke="rgba(31,61,59,.15)" stroke-width="1"/>
                <line x1="29" y1="29" x2="171" y2="171" stroke="rgba(31,61,59,.15)" stroke-width="1"/>
                <line x1="171" y1="29" x2="29" y2="171" stroke="rgba(31,61,59,.15)" stroke-width="1"/>
                <polygon points="100,30 165,75 145,160 70,170 35,90" fill="rgba(155,159,108,.35)" stroke="var(--oliva)" stroke-width="2"/>
                <circle cx="100" cy="30" r="4" fill="var(--carmesi)"/>
                <circle cx="165" cy="75" r="4" fill="var(--carmesi)"/>
                <circle cx="145" cy="160" r="4" fill="var(--carmesi)"/>
                <circle cx="70" cy="170" r="4" fill="var(--carmesi)"/>
                <circle cx="35" cy="90" r="4" fill="var(--carmesi)"/>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="para-quien">
    <div class="head">
      <span class="eyebrow">{p.paraQue.eyebrow}</span>
      <h2>{p.paraQue.titleStart} <span class="script block">{p.paraQue.titleScript}</span></h2>
    </div>
    <div class="quien-grid">
      {p.paraQue.items.map((item: any) => (
        <article class="quien-card">
          <span class="quien-num">{item.num}</span>
          <h3>{item.title}</h3>
          <p>{item.textStart}{item.textBold && <strong>{item.textBold}</strong>}{item.textEnd}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="bmap-deliverable">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">{p.deliverable.eyebrow}</span>
        <h2>{p.deliverable.titleStart} <span class="script block">{p.deliverable.titleScript}</span></h2>
        <p class="lead">{p.deliverable.lead}</p>
      </div>
      <div class="deliverable-cards">
        {p.deliverable.cards.map((card: any) => (
          <article class="deliverable-card">
            <span class="deliverable-num">{card.num}</span>
            <h3>{card.title}</h3>
            <ul>
              {card.items.map((item: string) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="modalidades" id="modalidades">
    <div class="head">
      <span class="eyebrow">{p.modalidades.eyebrow}</span>
      <h2>{p.modalidades.titleStart} <span class="script block">{p.modalidades.titleScript}</span></h2>
    </div>
    <div class="mod-grid">
      {p.modalidades.items.map((m: any) => (
        <article class={m.featured ? "mod-card featured" : "mod-card"}>
          {m.featured && m.badge && <span class="mod-badge">{m.badge}</span>}
          <span class="mod-num">{m.num}</span>
          <h3>{m.title}</h3>
          <p class="mod-tag">{m.tag}</p>
          <ul class="mod-includes">
            {m.includes.map((i: string) => <li>{i}</li>)}
          </ul>
          <div class="mod-price">{m.price}</div>
          <a href={m.ctaLink} class="btn">{m.ctaText}</a>
        </article>
      ))}
    </div>

    <div class="section-cta section-cta-centered">
      <p class="section-cta-text">¿Listo para tu foto?</p>
      <a href="/contacto" class="btn">Solicitar BMAP</a>
    </div>
  </section>

  <section class="bmap-process">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">{p.proceso.eyebrow}</span>
        <h2>{p.proceso.titleStart} <span class="script block">{p.proceso.titleScript}</span></h2>
      </div>
      <ol class="process-steps">
        {p.proceso.steps.map((step: any) => (
          <li class="process-step">
            <div class="step-circle">{step.num}</div>
            <div>
              <h4>{step.title}</h4>
              <p>
                {step.text}
                {step.textStart && (<>{step.textStart}<strong>{step.textBold}</strong>{step.textEnd}</>)}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="big-quote">
    <div class="wrap-tight">
      <span class="eyebrow lima">{p.bigQuote.eyebrow}</span>
      <q>{p.bigQuote.start} <span class="script">{p.bigQuote.script}</span> {p.bigQuote.end}</q>
      <div class="attribution">{p.bigQuote.attribution}</div>
    </div>
  </section>

  {p.faq && (
    <section class="faq">
      <div class="faq-inner">
        <div class="faq-head">
          <span class="eyebrow">{p.faq.eyebrow}</span>
          <h2>{p.faq.titleStart} <span class="script">{p.faq.titleScript}</span></h2>
        </div>
        <div class="faq-list">
          {p.faq.items.map((item: any) => (
            <details class="faq-item">
              <summary>{item.q}</summary>
              <div class="faq-answer"><p>{item.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="closing">
    <div class="wrap">
      <h2>{p.closing.titleStart} <span class="script block">{p.closing.titleScript}</span></h2>
      <p class="sub">{p.closing.subStart}<strong>{p.closing.subBold}</strong>{p.closing.subEnd}</p>
      <div class="actions">
        <a href={p.closing.ctaPrimaryLink} class="btn">{p.closing.ctaPrimaryText}</a>
        <a href={p.closing.ctaSecondaryLink} class="btn ghost">{p.closing.ctaSecondaryText}</a>
      </div>
    </div>
  </section>

</Base>
