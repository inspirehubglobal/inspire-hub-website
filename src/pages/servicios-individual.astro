---
import Base from "../layouts/Base.astro";
import { getEntry } from "astro:content";

const entry = await getEntry("pages", "servicios-individual");
if (!entry) throw new Error("servicios-individual.md not found");
const p = entry.data as any;

const SITE = "https://inspirehubglobal.com";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${SITE}/#org`,
      name: "Inspire Hub Global",
      url: SITE,
      logo: `${SITE}/assets/logos/logo-verde.png`
    },
    {
      "@type": "Service",
      name: "Coaching individual con Mabel",
      description: p.description,
      provider: { "@id": `${SITE}/#org` },
      url: `${SITE}/servicios-individual`,
      serviceType: "Coaching"
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Servicios", item: `${SITE}/servicios` },
        { "@type": "ListItem", position: 3, name: "Para ti · Individual", item: `${SITE}/servicios-individual` }
      ]
    }
  ]
};
---

<Base
  title={p.title}
  description={p.description}
  ogImage="/assets/photos/mujer-ventana.png"
  schema={schema}
  navTheme="light"
>

  <header class="page-hero">
    <div class="page-hero-inner">
      <span class="eyebrow">{p.hero.eyebrow}</span>
      <h1>{p.hero.titleStart} <span class="script block">{p.hero.titleScript}</span></h1>
      <p class="lead">{p.hero.leadStart}<strong>{p.hero.leadBold}</strong></p>
      <div class="page-hero-actions">
        <a href={p.hero.ctaPrimaryLink} class="btn">{p.hero.ctaPrimaryText}</a>
        <a href={p.hero.ctaSecondaryLink} class="btn ghost">{p.hero.ctaSecondaryText}</a>
      </div>
    </div>
  </header>

  <section class="para-quien">
    <div class="head">
      <span class="eyebrow">{p.paraQuien.eyebrow}</span>
      <h2>{p.paraQuien.titleStart} <span class="script block">{p.paraQuien.titleScript}</span></h2>
    </div>
    <div class="quien-grid">
      {p.paraQuien.items.map((item: any) => (
        <article class="quien-card">
          <span class="quien-num">{item.num}</span>
          <h3>{item.title}</h3>
          <p>{item.textStart}<strong>{item.textBold}</strong>{item.textEnd}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="manifesto">
    <div class="wrap">
      <div class="manifesto-grid">
        <div class="photo-col">
          <img src={p.manifesto.image} alt="Mabel · sesión de coaching" />
        </div>
        <div class="body-col">
          <span class="eyebrow lima">{p.manifesto.eyebrow}</span>
          <h2 class="pullquote">{p.manifesto.titleStart} <span class="script block">{p.manifesto.titleScript}</span></h2>
          <p class="lead">{p.manifesto.leadStart}<strong>{p.manifesto.leadBold}</strong></p>
          <p>{p.manifesto.p2}</p>
          <span class="signature">{p.manifesto.signature}</span>
          <a href={p.manifesto.ctaLink} class="btn carmesi">{p.manifesto.ctaText}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="filter-section">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">{p.filter.eyebrow}</span>
        <h2>{p.filter.titleStart} <span class="script block">{p.filter.titleScript}</span></h2>
        <p class="lead">{p.filter.lead}</p>
      </div>
      <div class="filter-grid">
        <article class="filter-card filter-yes">
          <span class="filter-eyebrow">{p.filter.yesEyebrow}</span>
          <ul>
            {p.filter.yesItems.map((item: any) => (
              <li>
                {item.textStart}
                {item.textBold && <strong>{item.textBold}</strong>}
                {item.textEnd || item.textRest}
              </li>
            ))}
          </ul>
          <p class="filter-note">{p.filter.yesNoteStart}<strong>{p.filter.yesNoteBold}</strong>{p.filter.yesNoteEnd}</p>
        </article>
        <article class="filter-card filter-no">
          <span class="filter-eyebrow">{p.filter.noEyebrow}</span>
          <ul>
            {p.filter.noItems.map((item: any) => (
              <li>
                {item.textStart}
                {item.textBold && <strong>{item.textBold}</strong>}
                {item.textEnd}
              </li>
            ))}
          </ul>
          <p class="filter-note">{p.filter.noNote}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="big-quote">
    <div class="wrap-tight">
      <span class="eyebrow lima">{p.bigQuote1.eyebrow}</span>
      <q>{p.bigQuote1.start} <span class="script">{p.bigQuote1.script}</span> {p.bigQuote1.end}</q>
      <div class="attribution">{p.bigQuote1.attribution}</div>
    </div>
  </section>

  <section class="modalidades" id="modalidades">
    <div class="head">
      <span class="eyebrow">{p.modalidades.eyebrow}</span>
      <h2>{p.modalidades.titleStart} <span class="script block">{p.modalidades.titleScript}</span></h2>
      <p class="lead">{p.modalidades.lead}</p>
    </div>
    <div class="mod-grid">
      {p.modalidades.items.map((m: any) => (
        <article class={m.featured ? "mod-card featured" : "mod-card"}>
          {m.featured && m.badge && <span class="mod-badge">{m.badge}</span>}
          <span class="mod-num">{m.num}</span>
          <h3>{m.title}</h3>
          <p class="mod-tag">{m.tag}</p>
          <ul class="mod-includes">
            {m.includes.map((i: string) => <li>{i}</li>)}
          </ul>
          <div class="mod-price">
            {m.price}
            {m.priceSmall && <small> {m.priceSmall}</small>}
          </div>
          <a href={m.ctaLink} class="btn">{m.ctaText}</a>
        </article>
      ))}
    </div>

    <div class="section-cta section-cta-centered">
      <p class="section-cta-text">Sin compromiso. 20 minutos para ver si encajamos.</p>
      <a href="/contacto" class="btn">Agendar conversación</a>
    </div>
  </section>

  <section class="big-quote">
    <div class="wrap-tight">
      <span class="eyebrow lima">{p.bigQuote2.eyebrow}</span>
      <q>{p.bigQuote2.start} <span class="script">{p.bigQuote2.script}</span> {p.bigQuote2.end}</q>
      <div class="attribution">{p.bigQuote2.attribution}</div>
    </div>
  </section>

  {p.faq && (
    <section class="faq">
      <div class="faq-inner">
        <div class="faq-head">
          <span class="eyebrow">{p.faq.eyebrow}</span>
          <h2>{p.faq.titleStart} <span class="script">{p.faq.titleScript}</span></h2>
        </div>
        <div class="faq-list">
          {p.faq.items.map((item: any) => (
            <details class="faq-item">
              <summary>{item.q}</summary>
              <div class="faq-answer"><p>{item.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="closing">
    <div class="wrap">
      <h2>{p.closing.titleStart} <span class="script block">{p.closing.titleScript}</span></h2>
      <p class="sub">{p.closing.subStart}<strong>{p.closing.subBold}</strong>{p.closing.subEnd}</p>
      <div class="actions">
        <a href={p.closing.ctaPrimaryLink} class="btn">{p.closing.ctaPrimaryText}</a>
        <a href={p.closing.ctaSecondaryLink} class="btn ghost">{p.closing.ctaSecondaryText}</a>
      </div>
    </div>
  </section>

</Base>
