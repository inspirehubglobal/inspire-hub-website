---
import Base from "../layouts/Base.astro";
import { getEntry, getCollection } from "astro:content";

const entry = await getEntry("pages", "recursos");
if (!entry) throw new Error("recursos.md not found");
const p = entry.data as any;

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const sorted = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const posts = sorted;
const categories = Array.from(new Set(posts.map(p => p.data.category)));

const SITE = "https://inspirehubglobal.com";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${SITE}/#org`,
      name: "Inspire Hub Global",
      url: SITE
    },
    {
      "@type": "CollectionPage",
      url: `${SITE}/recursos`,
      name: "Recursos · Lecturas",
      description: p.description,
      inLanguage: "es-DO"
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Recursos", item: `${SITE}/recursos` }
      ]
    }
  ]
};
---

<Base
  title={p.title}
  description={p.description}
  ogImage="/assets/photos/cemento-y-flores.png"
  schema={schema}
  navTheme="light"
>

  <header class="page-hero">
    <div class="page-hero-inner">
      <span class="eyebrow">{p.hero.eyebrow}</span>
      <h1>{p.hero.titleStart} <span class="script block">{p.hero.titleScript}</span></h1>
      <p class="lead">{p.hero.leadStart}<strong>{p.hero.leadBold}</strong></p>
    </div>
  </header>

  <section class="rec-filters">
    <button class="rec-filter active" data-filter="all">Todos</button>
    {categories.map(cat => (
      <button class="rec-filter" data-filter={cat}>{cat}</button>
    ))}
  </section>

  <section class="rec-grid-section">
    <div class="rec-grid">
      {posts.map(post => (
        <a href={`/blog-${post.id}`} class="rec-card" data-category={post.data.category}>
          {post.data.heroImage && (
            <div class="rec-thumb thumb-photo">
              <img src={post.data.heroImage} alt={post.data.heroAlt || ""} />
            </div>
          )}
          <div class="rec-body">
            <span class="rec-meta">{post.data.category}</span>
            <h3>{post.data.title} {post.data.titleScript && <span class="script block">{post.data.titleScript}</span>}</h3>
            <p>{post.data.lead}</p>
            <span class="rec-link">Leer →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <script is:inline>
    document.querySelectorAll('.rec-filter').forEach(btn => {
      btn.addEventListener('click', () => {
        const f = btn.dataset.filter;
        document.querySelectorAll('.rec-filter').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        document.querySelectorAll('.rec-card').forEach(card => {
          card.style.display = (f === 'all' || card.dataset.category === f) ? '' : 'none';
        });
      });
    });
  </script>

  <section class="section-cta section-cta-centered" style="padding: 8px clamp(40px, 5vw, 96px) 80px;">
    <p class="section-cta-text">¿Te tocó algo de aquí? Hablemos.</p>
    <a href="/contacto" class="btn">Agendar conversación</a>
  </section>

  <section class="vitamina">
    <div class="wrap">
      <div class="vitamina-grid">
        <div class="cover">
          <div class="cover-art">
            <img src="/assets/photos/mabel-podcast-home.png" alt="Vitamina I · podcast por Mabel" />
          </div>
        </div>
        <div class="content">
          <span class="eyebrow light">{p.vitamina.eyebrow}</span>
          <h2>{p.vitamina.titleStart} <span class="script">{p.vitamina.titleScript}</span> {p.vitamina.titleEnd}</h2>
          <p>{p.vitamina.textStart}<strong>{p.vitamina.textBold}</strong></p>
          <a href="/vitamina-i" class="btn">{p.vitamina.ctaText}</a>
        </div>
      </div>
    </div>
  </section>

</Base>
