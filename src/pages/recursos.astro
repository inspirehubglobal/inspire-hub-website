---
import Base from "../layouts/Base.astro";
import { getEntry, getCollection } from "astro:content";

const entry = await getEntry("pages", "recursos");
if (!entry) throw new Error("recursos.md not found");
const p = entry.data as any;

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const sorted = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const featured = sorted.find(post => post.id === p.featuredSlug) || sorted[0];
const rest = sorted.filter(post => post.id !== featured.id);

const SITE = "https://inspirehubglobal.com";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${SITE}/#org`,
      name: "Inspire Hub Global",
      url: SITE
    },
    {
      "@type": "CollectionPage",
      url: `${SITE}/recursos`,
      name: "Recursos · Lecturas",
      description: p.description,
      inLanguage: "es-DO"
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Recursos", item: `${SITE}/recursos` }
      ]
    }
  ]
};
---

<Base
  title={p.title}
  description={p.description}
  ogImage="/assets/photos/cemento-y-flores.png"
  schema={schema}
  navTheme="light"
>

  <header class="page-hero">
    <div class="page-hero-inner">
      <span class="eyebrow">{p.hero.eyebrow}</span>
      <h1>{p.hero.titleStart} <span class="script block">{p.hero.titleScript}</span></h1>
      <p class="lead">{p.hero.leadStart}<strong>{p.hero.leadBold}</strong></p>
    </div>
  </header>

  <section class="rec-featured">
    <article class="featured-card">
      {featured.data.heroImage && (
        <div class="featured-thumb thumb-photo">
          <img src={featured.data.heroImage} alt={featured.data.heroAlt || ""} />
        </div>
      )}
      <div class="featured-body">
        <span class="featured-eyebrow">Destacado · {featured.data.category}</span>
        <h2>{featured.data.title} {featured.data.titleScript && <span class="script block">{featured.data.titleScript}</span>}</h2>
        <p>{featured.data.lead}</p>
        <a href={`/blog-${featured.id}`} class="featured-link">Leer ensayo completo →</a>
      </div>
    </article>
  </section>

  <section class="rec-grid-section">
    <div class="rec-grid">
      {rest.map(post => (
        <a href={`/blog-${post.id}`} class="rec-card">
          {post.data.heroImage && (
            <div class="rec-thumb thumb-photo">
              <img src={post.data.heroImage} alt={post.data.heroAlt || ""} />
            </div>
          )}
          <div class="rec-body">
            <span class="rec-meta">{post.data.category} · {post.data.readTime.replace(' de lectura', '')}</span>
            <h3>{post.data.title} {post.data.titleScript && <span class="script block">{post.data.titleScript}</span>}</h3>
            <p>{post.data.lead}</p>
            <span class="rec-link">Leer →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="rec-newsletter">
    <div class="rec-news-inner">
      <span class="eyebrow lima">{p.newsletter.eyebrow}</span>
      <h2>{p.newsletter.titleStart} <span class="script block">{p.newsletter.titleScript}</span></h2>
      <form class="vita-form" onsubmit="return false;">
        <input type="email" placeholder={p.newsletter.emailPlaceholder} required />
        <button type="submit">{p.newsletter.submitText}</button>
        <p class="vita-fineprint">{p.newsletter.fineprint}</p>
      </form>
    </div>
  </section>

  <section class="vitamina">
    <div class="wrap">
      <div class="vitamina-grid">
        <div class="cover">
          <div class="cover-art">
            <img src="/assets/podcast/vitamina-i-cover.png" alt="Vitamina I · podcast por Mabel" />
          </div>
        </div>
        <div class="content">
          <span class="eyebrow light">{p.vitamina.eyebrow}</span>
          <h2>{p.vitamina.titleStart} <span class="script">{p.vitamina.titleScript}</span> {p.vitamina.titleEnd}</h2>
          <p>{p.vitamina.textStart}<strong>{p.vitamina.textBold}</strong></p>
          <a href="/vitamina-i" class="btn">{p.vitamina.ctaText}</a>
        </div>
      </div>
    </div>
  </section>

</Base>
