---
import Base from "../layouts/Base.astro";
import { getEntry } from "astro:content";

const entry = await getEntry("pages", "vitamina-i");
if (!entry) throw new Error("vitamina-i.md not found");
const p = entry.data as any;

const SITE = "https://inspirehubglobal.com";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${SITE}/#mabel`,
      name: "Mabel De Peña",
      jobTitle: "Coach ICF certificada",
      url: SITE
    },
    {
      "@type": "ProfessionalService",
      "@id": `${SITE}/#org`,
      name: "Inspire Hub Global",
      url: SITE
    },
    {
      "@type": "PodcastSeries",
      name: "Vitamina I",
      description: p.description,
      url: `${SITE}/vitamina-i`,
      image: `${SITE}/assets/podcast/vitamina-i-cover.png`,
      inLanguage: "es",
      author: { "@id": `${SITE}/#mabel` },
      publisher: { "@id": `${SITE}/#org` }
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Podcast · Vitamina I", item: `${SITE}/vitamina-i` }
      ]
    }
  ]
};
---

<Base
  title={p.title}
  description={p.description}
  ogImage="/assets/podcast/vitamina-i-cover.png"
  schema={schema}
  navTheme="light"
>

  <header class="page-hero">
    <div class="page-hero-inner">
      <span class="eyebrow">{p.hero.eyebrow}</span>
      <h1>{p.hero.titleStart} <span class="script block">{p.hero.titleScript}</span></h1>
      <p class="lead">{p.hero.leadStart}<strong>{p.hero.leadBold}</strong></p>
      <p class="vita-availability">{p.hero.availabilityStart}<strong>{p.hero.availabilityDate}</strong>{p.hero.availabilityEnd}</p>
      <div class="page-hero-actions">
        <a href={p.hero.ctaPrimaryLink} class="btn">{p.hero.ctaPrimaryText}</a>
        <a href={p.hero.ctaSecondaryLink} class="btn ghost">{p.hero.ctaSecondaryText}</a>
      </div>
    </div>
  </header>

  <section class="pronto">
    <div class="pronto-wrap">
      <div class="pronto-mockup">
        <img src="/assets/podcast/vitamina-iphone.png" alt="iPhone con el podcast Vitamina I" />
      </div>
      <div class="pronto-body">
        <span class="eyebrow">{p.pronto.eyebrow}</span>
        <h2 class="pronto-headline">{p.pronto.headlineStart} <em>{p.pronto.headlineEm}</em> {p.pronto.headlineEnd}</h2>
        <p class="pronto-sub">{p.pronto.sub}</p>
        <a href="#avisame" class="pronto-link">{p.pronto.linkText} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="quien-es">
    <div class="quien-es-wrap">
      <span class="quien-es-eye">{p.quienEs.eyebrow}</span>
      <h2 class="quien-es-h2">{p.quienEs.titleStart} <span class="quien-es-script">{p.quienEs.titleScript}</span></h2>
      <div class="quien-es-body">
        <p>{p.quienEs.p1}</p>
        <p>{p.quienEs.p2}</p>
        <p class="quien-es-callout">{p.quienEs.callout}</p>
      </div>
    </div>
  </section>

  <section class="big-quote">
    <div class="wrap-tight">
      <span class="eyebrow lima">{p.bigQuote.eyebrow}</span>
      <q>{p.bigQuote.start} <span class="script">{p.bigQuote.script}</span> {p.bigQuote.end}</q>
      <div class="attribution">{p.bigQuote.attribution}</div>
    </div>
  </section>

  <section class="avisame" id="avisame">
    <div class="wrap-tight">
      <span class="eyebrow">{p.avisame.eyebrow}</span>
      <h2>{p.avisame.titleStart} <span class="script block">{p.avisame.titleScript}</span></h2>
      <p>{p.avisame.lead}</p>
      <form class="avisame-form" onsubmit="return false;">
        <input type="text" placeholder={p.avisame.namePlaceholder} required />
        <input type="email" placeholder={p.avisame.emailPlaceholder} required />
        <button type="submit">{p.avisame.submitText}</button>
      </form>
      <p class="avisame-fineprint">{p.avisame.fineprint}</p>
    </div>
  </section>

  <section class="closing closing-vita">
    <div class="wrap">
      <h2>{p.closing.titleStart} <span class="script">{p.closing.titleScript}</span>{p.closing.titleEnd}</h2>
      <p class="sub">{p.closing.sub}</p>
      <div class="actions">
        <a href={p.closing.ctaPrimaryLink} class="btn">{p.closing.ctaPrimaryText}</a>
        <a href={p.closing.ctaSecondaryLink} class="btn ghost">{p.closing.ctaSecondaryText}</a>
      </div>
    </div>
  </section>

</Base>
