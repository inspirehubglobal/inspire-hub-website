---
import Base from "../layouts/Base.astro";
import { getEntry } from "astro:content";

const entry = await getEntry("pages", "servicios-empresas");
if (!entry) throw new Error("servicios-empresas.md not found");
const p = entry.data as any;

const SITE = "https://inspirehubglobal.com";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${SITE}/#org`,
      name: "Inspire Hub Global",
      url: SITE
    },
    {
      "@type": "Service",
      name: "Coaching ejecutivo y formación para empresas",
      description: p.description,
      provider: { "@id": `${SITE}/#org` },
      url: `${SITE}/servicios-empresas`,
      serviceType: "Coaching"
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Servicios", item: `${SITE}/servicios` },
        { "@type": "ListItem", position: 3, name: "Para tu equipo · Empresas", item: `${SITE}/servicios-empresas` }
      ]
    }
  ]
};
---

<Base
  title={p.title}
  description={p.description}
  ogImage="/assets/photos/grouptalk.png"
  schema={schema}
  navTheme="light"
>

  <header class="page-hero">
    <div class="page-hero-inner">
      <span class="eyebrow">{p.hero.eyebrow}</span>
      <h1>{p.hero.titleStart} <span class="script block">{p.hero.titleScript}</span></h1>
      <p class="lead">{p.hero.leadStart}<strong>{p.hero.leadBold}</strong></p>
      <div class="page-hero-actions">
        <a href={p.hero.ctaPrimaryLink} class="btn">{p.hero.ctaPrimaryText}</a>
        <a href={p.hero.ctaSecondaryLink} class="btn ghost">{p.hero.ctaSecondaryText}</a>
      </div>
    </div>
  </header>

  <section class="serv-cards">
    <div class="serv-grid">
      {p.formatos.items.map((f: any) => (
        <article class="serv-card serv-card-static">
          <span class="serv-num">{f.letter}</span>
          <h2>{f.title}</h2>
          <p class="serv-tag">{f.tag}</p>
          <p>{f.bodyStart}<strong>{f.bodyBold}</strong>{f.bodyEnd}</p>
          <ul class="serv-meta">
            {f.meta.map((m: string) => <li>{m}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="metodo-stack" id="talleres">
    <div class="head" style="margin-bottom: 32px;">
      <span class="eyebrow">{p.talleres.eyebrow}</span>
      <h2>{p.talleres.titleStart} <span class="script block">{p.talleres.titleScript}</span></h2>
    </div>

    <div class="wrap" style="padding: 0; max-width: none;">
      {p.talleres.items.map((t: any) => (
        <article class="taller-row">
          <div class="taller-meta">
            <span class="taller-num">{t.num}</span>
            <span class="taller-dur">{t.duration}</span>
          </div>
          <div class="taller-content">
            <h3>{t.titleStart} <span class="script block">{t.titleScript}</span></h3>
            <p>{t.text}</p>
          </div>
          {t.price && <div class="taller-price">{t.price}</div>}
        </article>
      ))}

      <div class="section-cta section-cta-centered">
        <p class="section-cta-text">¿Quieres armar un programa a medida?</p>
        <a href="/contacto" class="btn">Solicitar propuesta</a>
      </div>
    </div>
  </section>

  <section class="big-quote">
    <div class="wrap-tight">
      <span class="eyebrow lima">{p.bigQuote.eyebrow}</span>
      <q>{p.bigQuote.start} <span class="script">{p.bigQuote.script}</span> {p.bigQuote.end}</q>
      <div class="attribution">{p.bigQuote.attribution}</div>
    </div>
  </section>

  <section class="industries">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">{p.industrias.eyebrow}</span>
        <h2>{p.industrias.titleStart} <span class="script block">{p.industrias.titleScript}</span></h2>
        <p class="lead">{p.industrias.leadStart}<strong>{p.industrias.leadBold}</strong></p>
      </div>
      <div class="pills-grid">
        {p.industrias.pills.map((pill: string) => <span class="industry-pill">{pill}</span>)}
      </div>
    </div>
  </section>

  <section class="filter-section">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">{p.filter.eyebrow}</span>
        <h2>{p.filter.titleStart} <span class="script block">{p.filter.titleScript}</span></h2>
        <p class="lead">{p.filter.lead}</p>
      </div>
      <div class="filter-grid">
        <article class="filter-card filter-yes">
          <span class="filter-eyebrow">{p.filter.yesEyebrow}</span>
          <ul>
            {p.filter.yesItems.map((item: any) => (
              <li>
                {item.textStart}
                {item.textBold && <strong>{item.textBold}</strong>}
                {item.textEnd}
              </li>
            ))}
          </ul>
          <p class="filter-note">{p.filter.yesNoteStart}<strong>{p.filter.yesNoteBold}</strong>{p.filter.yesNoteEnd}</p>
        </article>
        <article class="filter-card filter-no">
          <span class="filter-eyebrow">{p.filter.noEyebrow}</span>
          <ul>
            {p.filter.noItems.map((item: any) => (
              <li>
                {item.textStart}
                {item.textBold && <strong>{item.textBold}</strong>}
                {item.textEnd}
              </li>
            ))}
          </ul>
          <p class="filter-note">{p.filter.noNote}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="credenciales">
    <div class="wrap">
      <div class="cred-grid">
        <div>
          <span class="eyebrow">{p.inversion.eyebrow}</span>
          <h2>{p.inversion.titleStart} <span class="script block">{p.inversion.titleScript}</span></h2>
        </div>
        <ul class="cred-list">
          {p.inversion.items.map((item: any) => (
            <li><span class="dot"></span><strong>{item.textBold}</strong>{item.textRest}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {p.faq && (
    <section class="faq">
      <div class="faq-inner">
        <div class="faq-head">
          <span class="eyebrow">{p.faq.eyebrow}</span>
          <h2>{p.faq.titleStart} <span class="script">{p.faq.titleScript}</span></h2>
        </div>
        <div class="faq-list">
          {p.faq.items.map((item: any) => (
            <details class="faq-item">
              <summary>{item.q}</summary>
              <div class="faq-answer"><p>{item.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="closing">
    <div class="wrap">
      <h2>{p.closing.titleStart} <span class="script block">{p.closing.titleScript}</span></h2>
      <p class="sub">{p.closing.subStart}<strong>{p.closing.subBold}</strong>{p.closing.subEnd}</p>
      <div class="actions">
        <a href={p.closing.ctaPrimaryLink} class="btn">{p.closing.ctaPrimaryText}</a>
        <a href={p.closing.ctaSecondaryLink} class="btn ghost">{p.closing.ctaSecondaryText}</a>
      </div>
    </div>
  </section>

</Base>
