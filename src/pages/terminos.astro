---
import Base from "../layouts/Base.astro";
import { getEntry, render } from "astro:content";

const entry = await getEntry("pages", "terminos");
if (!entry) throw new Error("terminos.md not found");
const p = entry.data as any;
const { Content } = await render(entry);

const SITE = "https://inspirehubglobal.com";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${SITE}/#org`,
      name: "Inspire Hub Global",
      url: SITE
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Términos y Condiciones", item: `${SITE}/terminos` }
      ]
    }
  ]
};
---

<Base
  title={p.title}
  description={p.description}
  ogImage="/assets/logos/logo-verde.png"
  schema={schema}
  navTheme="light"
>

  <header class="post-hero post-hero--legal">
    <div class="post-hero-inner">
      <span class="post-meta">{p.heroEyebrow}</span>
      <h1 class="post-title">{p.heroTitleStart} <span class="script block legal-italic">{p.heroTitleScript}</span></h1>
      <p class="post-byline">Última actualización: <strong>{p.lastUpdated}</strong></p>
    </div>
  </header>

  <article class="post-body">
    <p class="post-lead">{p.lead}</p>
    <Content />
  </article>

  <section class="closing">
    <div class="wrap">
      <h2>{p.closing.titleStart} <span class="script block">{p.closing.titleScript}</span></h2>
      <p class="sub">{p.closing.subStart}<strong>{p.closing.subBold}</strong>{p.closing.subEnd}</p>
      <div class="actions">
        <a href={p.closing.ctaPrimaryLink} class="btn">{p.closing.ctaPrimaryText}</a>
        <a href={p.closing.ctaSecondaryLink} class="btn ghost">{p.closing.ctaSecondaryText}</a>
      </div>
    </div>
  </section>

</Base>
