---
import Base from "../../layouts/Base.astro";
import { capsulas } from "../../data/capsulas";

const SITE = "https://inspirehubglobal.com";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${SITE}/#org`,
      name: "Inspire Hub Global",
      url: SITE
    },
    {
      "@type": "CollectionPage",
      url: `${SITE}/capsulas`,
      name: "Cápsulas Vitamina I",
      description:
        "Cinco cápsulas de audio para detenerte, escucharte y reconectar con lo que de verdad te importa.",
      inLanguage: "es-DO"
    }
  ]
};
---

<Base
  title="Cápsulas Vitamina I · Inspire Hub Global"
  description="Cinco cápsulas de audio de María Isabel para detenerte, escucharte y reconectar con lo que de verdad te importa."
  schema={schema}
  navTheme="light"
>
  <header class="page-hero">
    <div class="page-hero-inner">
      <span class="eyebrow">Cápsulas · Vitamina I</span>
      <h1>Cinco pausas para <span class="script block">volver a ti</span></h1>
      <p class="lead">
        Cinco audios cortos que grabé yo. Las cosas que me hubiese gustado
        escuchar en esos momentos donde todo funcionaba pero algo por dentro no
        estaba bien. <strong>Escúchalas sin prisa.</strong>
      </p>
    </div>
  </header>

  <section class="caps-list">
    <div class="caps-list-wrap">
      {capsulas.map((c) => (
        <a class="cap-row" href={`/capsulas/${c.slug}`}>
          <span class="cap-row-num">{String(c.n).padStart(2, "0")}</span>
          <span class="cap-row-body">
            <span class="cap-row-title">{c.titulo}</span>
            <span class="cap-row-framing">{c.framing}</span>
          </span>
          <span class="cap-row-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <style>
    .caps-list {
      padding: 0 1.5rem 6rem;
    }
    .caps-list-wrap {
      max-width: 720px;
      margin: 0 auto;
    }
    .cap-row {
      display: flex;
      align-items: flex-start;
      gap: 1.25rem;
      text-decoration: none;
      color: inherit;
      border-top: 1px solid rgba(0, 0, 0, 0.12);
      padding: 1.75rem 0;
      transition: opacity 0.2s ease;
    }
    .cap-row:hover {
      opacity: 0.6;
    }
    .cap-row-num {
      font-family: "Instrument Serif", serif;
      font-size: 1.75rem;
      line-height: 1;
      opacity: 0.4;
      min-width: 2.5rem;
    }
    .cap-row-body {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .cap-row-title {
      font-family: "Instrument Serif", serif;
      font-size: 1.5rem;
      line-height: 1.15;
    }
    .cap-row-framing {
      font-size: 1rem;
      line-height: 1.5;
      opacity: 0.7;
    }
    .cap-row-arrow {
      font-size: 1.25rem;
      opacity: 0.5;
      align-self: center;
    }
    @media (max-width: 540px) {
      .cap-row-title { font-size: 1.25rem; }
      .cap-row-framing { font-size: 0.9rem; }
    }
  </style>
</Base>
