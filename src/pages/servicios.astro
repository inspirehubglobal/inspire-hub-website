---
import Base from "../layouts/Base.astro";
import { getEntry } from "astro:content";

const entry = await getEntry("pages", "servicios");
if (!entry) throw new Error("servicios.md not found");
const p = entry.data as any;

const SITE = "https://inspirehubglobal.com";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${SITE}/#org`,
      name: "Inspire Hub Global",
      url: SITE,
      logo: `${SITE}/assets/logos/logo-verde.png`,
      email: "hola@inspirehubglobal.com"
    },
    {
      "@type": "CollectionPage",
      url: `${SITE}/servicios`,
      name: "Servicios de coaching",
      inLanguage: "es-DO"
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Servicios", item: `${SITE}/servicios` }
      ]
    }
  ]
};
---

<Base
  title={p.title}
  description={p.description}
  ogImage="/assets/photos/cemento-y-flores.png"
  schema={schema}
  navTheme="light"
>

  <header class="page-hero">
    <div class="page-hero-inner">
      <span class="eyebrow">{p.heroEyebrow}</span>
      <h1>{p.heroTitleStart} <span class="script block">{p.heroTitleScript}</span></h1>
      <p class="lead">{p.heroLeadStart}<strong>{p.heroLeadBold}</strong></p>
    </div>
  </header>

  <section class="serv-cards">
    <div class="serv-grid">
      {p.services.map((s: any) => (
        <a href={s.link} class="serv-card">
          <span class="serv-num">{s.num}</span>
          <h2>{s.title}</h2>
          <p class="serv-tag">{s.tag}</p>
          <p>{s.bodyStart}<strong>{s.bodyBold}</strong>{s.bodyEnd}</p>
          <ul class="serv-meta">
            {s.meta.map((m: string) => <li>{m}</li>)}
          </ul>
          <span class="serv-link">{s.linkText}</span>
        </a>
      ))}
    </div>

    <div class="section-cta section-cta-centered">
      <p class="section-cta-text">¿No sabes cuál elegir? Hablamos primero.</p>
      <a href="/contacto" class="btn">Agendar conversación</a>
    </div>
  </section>

  <section class="big-quote">
    <div class="wrap-tight">
      <span class="eyebrow lima">{p.bigQuoteEyebrow}</span>
      <q>{p.bigQuoteStart} <span class="script">{p.bigQuoteScript}</span></q>
      <div class="attribution">{p.bigQuoteAttribution}</div>
    </div>
  </section>

  <section class="vitamina">
    <div class="wrap">
      <div class="vitamina-grid">
        <div class="cover">
          <div class="cover-art">
            <img src="/assets/photos/mabel-podcast-home.png" alt="Vitamina I · podcast por Mabel" />
          </div>
        </div>
        <div class="content">
          <span class="eyebrow light">{p.vitaminaEyebrow}</span>
          <h2>{p.vitaminaTitleStart} <span class="script block">{p.vitaminaTitleScript}</span></h2>
          <p>{p.vitaminaTextStart}<strong>{p.vitaminaTextBold}</strong></p>
          <a href="/vitamina-i" class="btn">{p.vitaminaCtaText}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="wrap">
      <h2>{p.closingTitleStart}<span class="script">{p.closingTitleScript}</span> {p.closingTitleEnd}</h2>
      <p class="sub">{p.closingSubStart}<strong>{p.closingSubBold}</strong>{p.closingSubEnd}</p>
      <div class="actions">
        <a href={p.closingCtaPrimaryLink} class="btn">{p.closingCtaPrimaryText}</a>
        <a href={p.closingCtaSecondaryLink} class="btn ghost">{p.closingCtaSecondaryText}</a>
      </div>
    </div>
  </section>

</Base>
