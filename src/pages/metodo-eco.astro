---
import Base from "../layouts/Base.astro";
import { getEntry } from "astro:content";

const entry = await getEntry("pages", "metodo-eco");
if (!entry) throw new Error("metodo-eco.md not found");
const p = entry.data as any;

const SITE = "https://inspirehubglobal.com";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${SITE}/#mabel`,
      name: "Mabel De Peña",
      jobTitle: "Coach ICF certificada",
      url: SITE
    },
    {
      "@type": "ProfessionalService",
      "@id": `${SITE}/#org`,
      name: "Inspire Hub Global",
      url: SITE
    },
    {
      "@type": "Article",
      headline: "Método ECO: Escuchar, Conectar, Orientar",
      description: p.description,
      author: { "@id": `${SITE}/#mabel` },
      publisher: { "@id": `${SITE}/#org` },
      inLanguage: "es-DO",
      mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE}/metodo-eco` }
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Método ECO", item: `${SITE}/metodo-eco` }
      ]
    }
  ]
};
---

<Base
  title={p.title}
  description={p.description}
  ogImage="/assets/photos/cemento-y-flores.png"
  schema={schema}
  navTheme="light"
>

  <header class="metodo-hero">
    <div class="metodo-hero-inner">
      <span class="eyebrow">{p.hero.eyebrow}</span>
      <h1>
        <span class="letter">E</span>scucha.
        <span class="letter">C</span>onecta.
        <span class="letter">O</span>rienta.
      </h1>
      <p class="lead">{p.hero.leadStart}<strong>{p.hero.leadBold}</strong></p>
    </div>
  </header>

  <section class="manifesto">
    <div class="wrap">
      <div class="manifesto-grid" style="grid-template-columns: 1fr 0.85fr;">
        <div class="body-col">
          <span class="eyebrow lima">{p.manifesto.eyebrow}</span>
          <h2 class="pullquote">{p.manifesto.titleStart} <span class="script block">{p.manifesto.titleScript}</span></h2>
          <p class="lead">{p.manifesto.lead}</p>
          <p>{p.manifesto.p2Start}<strong>{p.manifesto.p2Bold}</strong>{p.manifesto.p2End}</p>
          <span class="signature">{p.manifesto.signature}</span>
        </div>
        <div class="photo-col">
          <img src={p.manifesto.image} alt="Mabel · método ECO" />
        </div>
      </div>
    </div>
  </section>

  <section class="eco-visual">
    <div class="eco-flow">
      {p.ecoNodes.map((node: any, idx: number) => (
        <>
          <article class="eco-node">
            <span class="eco-num">{node.num}</span>
            <span class="eco-glyph">{node.letter}</span>
            <h3 class="eco-action">{node.action}</h3>
            <span class="eco-key">{node.key}</span>
            <p class="eco-desc">{node.desc}</p>
          </article>
          {idx < p.ecoNodes.length - 1 && (
            <div class="eco-bridge" aria-hidden="true">
              <span class="eco-bridge-dot"></span>
              <span class="eco-bridge-line"></span>
              <span class="eco-bridge-dot"></span>
            </div>
          )}
        </>
      ))}
    </div>
  </section>

  <section class="eco-anchor">
    <div class="eco-anchor-inner">
      <span class="eyebrow">{p.anchor.eyebrow}</span>
      <h2>{p.anchor.titleStart} <span class="script block">{p.anchor.titleScript}</span></h2>
      <p class="lead">{p.anchor.lead}</p>
    </div>
  </section>

  <section class="metodo-stack">
    <div class="wrap">
      {p.ecoSteps.map((step: any) => (
        <article class="metodo-step">
          <div class="step-num">
            <span class="big">{step.letter}</span>
          </div>
          <div class="step-content">
            <h2>{step.titleStart} <span class="script block">{step.titleScript}</span></h2>
            <p class="lead">{step.lead}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="dual-section">
    <div class="wrap">
      <div class="head" style="text-align: center; margin-bottom: 56px;">
        <span class="eyebrow" style="justify-content: center;">{p.dual.eyebrow}</span>
        <h2>{p.dual.titleStart} <span class="script block">{p.dual.titleScript}</span></h2>
      </div>
      <div class="dual-grid">
        {p.dual.cards.map((card: any) => (
          <article class="dual-card">
            <span class="dual-num">{card.num}</span>
            <h3>{card.title}</h3>
            <p class="dual-tag">{card.tag}</p>
            <p>{card.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="big-quote">
    <div class="wrap-tight">
      <span class="eyebrow lima">{p.bigQuote.eyebrow}</span>
      <q>{p.bigQuote.start} <span class="script">{p.bigQuote.script}</span> {p.bigQuote.end}</q>
      <div class="attribution">{p.bigQuote.attribution}</div>
    </div>
  </section>

  <section class="vitamina">
    <div class="wrap">
      <div class="vitamina-grid">
        <div class="cover">
          <div class="cover-art">
            <img src="/assets/podcast/vitamina-i-cover.png" alt="Vitamina I · podcast por Mabel" />
          </div>
        </div>
        <div class="content">
          <span class="eyebrow light">{p.vitamina.eyebrow}</span>
          <h2>{p.vitamina.titleStart} <span class="script">{p.vitamina.titleScript}</span> {p.vitamina.titleEnd}</h2>
          <p>{p.vitamina.textStart}<strong>{p.vitamina.textBold}</strong></p>
          <a href="/vitamina-i" class="btn">{p.vitamina.ctaText}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="wrap">
      <h2>{p.closing.titleStart}<span class="script">{p.closing.titleScript}</span> {p.closing.titleEnd}</h2>
      <p class="sub">{p.closing.subStart}<strong>{p.closing.subBold}</strong>{p.closing.subEnd}</p>
      <div class="actions">
        <a href={p.closing.ctaPrimaryLink} class="btn">{p.closing.ctaPrimaryText}</a>
        <a href={p.closing.ctaSecondaryLink} class="btn ghost">{p.closing.ctaSecondaryText}</a>
      </div>
    </div>
  </section>

</Base>
