---
import Base from "../layouts/Base.astro";
import { getEntry } from "astro:content";

const entry = await getEntry("pages", "sobre-mabel");
if (!entry) throw new Error("sobre-mabel.md not found");
const p = entry.data as any;

const SITE = "https://inspirehubglobal.com";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${SITE}/#mabel`,
      name: "Mabel De Peña",
      alternateName: "María Isabel De Peña Meyreles",
      jobTitle: "Coach ICF certificada",
      description: "Coach ICF certificada con 20 años en banca corporativa. Acompaña turning points de vida y carrera con método ECO y BMAP.",
      url: SITE,
      image: `${SITE}/assets/photos/mabel-contexto.png`,
      worksFor: { "@id": `${SITE}/#org` }
    },
    {
      "@type": "ProfessionalService",
      "@id": `${SITE}/#org`,
      name: "Inspire Hub Global",
      founder: { "@id": `${SITE}/#mabel` },
      url: SITE,
      logo: `${SITE}/assets/logos/logo-verde.png`,
      email: "hola@inspirehubglobal.com"
    },
    {
      "@type": "AboutPage",
      url: `${SITE}/sobre-mabel`,
      mainEntity: { "@id": `${SITE}/#mabel` },
      inLanguage: "es-DO"
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Sobre Mabel", item: `${SITE}/sobre-mabel` }
      ]
    }
  ]
};
---

<Base
  title={p.title}
  description={p.description}
  ogImage={p.heroImage}
  ogType="profile"
  schema={schema}
  navTheme="light"
>

  <section class="manifesto manifesto-hero">
    <div class="wrap">
      <div class="manifesto-grid">
        <div class="photo-col">
          <img src={p.heroImage} alt="Mabel · Inspire Hub Global" />
        </div>
        <div class="body-col">
          <span class="eyebrow lima">{p.heroEyebrow}</span>
          <h1 class="pullquote">{p.heroTitleStart} <span class="script block">{p.heroTitleScript}</span></h1>
          <p class="lead">{p.heroLead}</p>
          <p>{p.heroP2}</p>
          <p>{p.heroP3Start}<strong>{p.heroP3Bold}</strong></p>
          <span class="signature">{p.heroSignature}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="eco">
    <div class="wrap">
      <header class="eco-head">
        <span class="eyebrow lima">{p.audienceEyebrow}</span>
        <h2>{p.audienceTitleStart} <span class="script block">{p.audienceTitleScript}</span></h2>
        <p>{p.audienceIntro}</p>
      </header>

      <ol class="eco-stack">
        {p.audienceItems.map((item: any) => (
          <li class="eco-row">
            <span class="num">{item.num}<small>{item.label}</small></span>
            <div class="content">
              <h3>{item.title}</h3>
              <p class="tag">{item.tag}</p>
              <p>{item.text}</p>
            </div>
          </li>
        ))}
      </ol>

      <p class="eco-foot">{p.audienceFootStart}<strong>{p.audienceFootBold}</strong></p>
    </div>
  </section>

  <section class="servicios">
    <div class="wrap">
      <div class="head">
        <h2 class="display">{p.methodTitleStart} <span class="script block">{p.methodTitleScript}</span></h2>
        <p class="lead">{p.methodLead}</p>
      </div>

      <div class="method-grid">
        {p.methodCards.map((card: any) => (
          <a href={card.link} class="method-card">
            <div class="num">{card.letter}</div>
            <h3>{card.title}</h3>
            <div class="for">{card.for}</div>
            <p class="meta">{card.meta}</p>
            <p>
              {card.text}
              {card.textStart && (<>{card.textStart}<strong>{card.textBold}</strong>{card.textEnd}</>)}
            </p>
            <span class="card-link">{card.linkText}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="credenciales">
    <div class="wrap">
      <div class="cred-grid">
        <div>
          <span class="eyebrow">{p.credEyebrow}</span>
          <h2>{p.credTitleStart} <span class="script">{p.credTitleScript}</span></h2>
        </div>
        <ul class="cred-list">
          {p.credList.map((item: string) => (
            <li><span class="dot"></span>{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="big-quote">
    <div class="wrap-tight">
      <span class="eyebrow lima">{p.bigQuoteEyebrow}</span>
      <q>{p.bigQuoteStart} <span class="script">{p.bigQuoteScript}</span></q>
      <div class="attribution">{p.bigQuoteAttribution}</div>
    </div>
  </section>

  <section class="vitamina">
    <div class="wrap">
      <div class="vitamina-grid">
        <div class="cover">
          <div class="cover-art">
            <img src="/assets/podcast/vitamina-i-cover.png" alt="Vitamina I · podcast por Mabel" />
          </div>
        </div>
        <div class="content">
          <span class="eyebrow light">{p.vitaminaEyebrow}</span>
          <h2>{p.vitaminaTitleStart} <span class="script">{p.vitaminaTitleScript}</span> {p.vitaminaTitleEnd}</h2>
          <p>{p.vitaminaTextStart}<strong>{p.vitaminaTextBold}</strong></p>
          <a href="/vitamina-i" class="btn">{p.vitaminaCtaText}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="wrap">
      <h2>{p.closingTitleStart}<span class="script">{p.closingTitleScript}</span> {p.closingTitleEnd}</h2>
      <p class="sub">{p.closingSubStart}<strong>{p.closingSubBold}</strong>{p.closingSubEnd}</p>
      <div class="actions">
        <a href={p.closingCtaPrimaryLink} class="btn">{p.closingCtaPrimaryText}</a>
        <a href={p.closingCtaSecondaryLink} class="btn ghost">{p.closingCtaSecondaryText}</a>
      </div>
    </div>
  </section>

</Base>
