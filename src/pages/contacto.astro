---
import Base from "../layouts/Base.astro";
import { getEntry } from "astro:content";

const entry = await getEntry("pages", "contacto");
if (!entry) throw new Error("contacto.md not found");
const p = entry.data as any;

const SITE = "https://inspirehubglobal.com";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${SITE}/#org`,
      name: "Inspire Hub Global",
      url: SITE,
      email: p.infoEmail
    },
    {
      "@type": "ContactPage",
      url: `${SITE}/contacto`,
      inLanguage: "es-DO",
      mainEntity: { "@id": `${SITE}/#org` }
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Contacto", item: `${SITE}/contacto` }
      ]
    }
  ]
};
---

<Base
  title={p.title}
  description={p.description}
  ogImage="/assets/photos/cemento-y-flores.png"
  schema={schema}
  navTheme="light"
>

  <header class="page-hero">
    <div class="page-hero-inner">
      <span class="eyebrow">{p.heroEyebrow}</span>
      <h1>{p.heroTitleStart} <span class="script block">{p.heroTitleScript}</span></h1>
      <p class="lead">{p.heroLeadStart}<strong>{p.heroLeadBold}</strong></p>
    </div>
  </header>

  <section class="contacto-section">
    <div class="contacto-grid">
      <div class="contacto-form-col">
        <span class="eyebrow lima">{p.formEyebrow}</span>
        <h2>{p.formTitleStart} <span class="script block">{p.formTitleScript}</span></h2>

        <form class="contacto-form" onsubmit="return false;">
          <div class="form-row">
            <input type="text" name="nombre" placeholder={p.formNombrePlaceholder} required />
            <input type="email" name="email" placeholder={p.formEmailPlaceholder} required />
          </div>
          <select name="tema" required>
            <option value="">{p.formTemaPlaceholder}</option>
            {p.formTemaOptions.map((opt: any) => (
              <option value={opt.value}>{opt.label}</option>
            ))}
          </select>
          <textarea name="mensaje" placeholder={p.formMensajePlaceholder} rows="5" required></textarea>
          <button type="submit">{p.formSubmitText}</button>
          <p class="form-fineprint">{p.formFineprint}</p>
        </form>
      </div>

      <aside class="contacto-info">
        <div class="info-block">
          <span class="info-eyebrow">{p.infoEmailLabel}</span>
          <p><a href={`mailto:${p.infoEmail}`}>{p.infoEmail}</a></p>
        </div>

        <div class="info-block">
          <span class="info-eyebrow">{p.infoCallLabel}</span>
          <h3 class="info-title">{p.infoCallTitleStart}<em>{p.infoCallTitleEm}</em></h3>
          <p>{p.infoCallTextStart}<strong>{p.infoCallTextBold}</strong>{p.infoCallTextEnd}</p>
        </div>

        <div class="info-block">
          <span class="info-eyebrow">{p.infoLocationLabel}</span>
          <p>{p.infoLocationText}</p>
        </div>

        <div class="info-block">
          <span class="info-eyebrow">{p.infoSocialLabel}</span>
          <p>
            <a href="https://instagram.com/inspirehubglobal" target="_blank" rel="noopener">↗ Instagram</a>
            &nbsp;·&nbsp;
            <a href="https://www.linkedin.com/company/inspire-hub-global" target="_blank" rel="noopener">↗ LinkedIn</a>
          </p>
        </div>
      </aside>
    </div>
  </section>

  <section class="big-quote">
    <div class="wrap-tight">
      <span class="eyebrow lima">{p.bigQuoteEyebrow}</span>
      <q>{p.bigQuoteStart} <span class="script">{p.bigQuoteScript}</span></q>
      <div class="attribution">{p.bigQuoteAttribution}</div>
    </div>
  </section>

  <section class="vitamina">
    <div class="wrap">
      <div class="vitamina-grid">
        <div class="cover">
          <div class="cover-art">
            <img src="/assets/podcast/vitamina-i-cover.png" alt="Vitamina I · podcast por Mabel" />
          </div>
        </div>
        <div class="content">
          <span class="eyebrow light">{p.vitaminaEyebrow}</span>
          <h2>{p.vitaminaTitleStart} <span class="script">{p.vitaminaTitleScript}</span> {p.vitaminaTitleEnd}</h2>
          <p>{p.vitaminaTextStart}<strong>{p.vitaminaTextBold}</strong></p>
          <a href="/vitamina-i" class="btn">{p.vitaminaCtaText}</a>
        </div>
      </div>
    </div>
  </section>

</Base>
